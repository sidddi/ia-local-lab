{
  "name": "ia-local-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-runtime.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-runtime.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "samples": "node scripts/make-samples.mjs",
    "fetch-models": "node scripts/fetch-models.mjs",
    "pretest": "node scripts/copy-runtime.mjs && node scripts/install-fixtures.mjs",
    "test": "node --test tests/unit/*.test.mjs && playwright test",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "pretest:e2e": "node scripts/copy-runtime.mjs && node scripts/install-fixtures.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@mlc-ai/web-llm": "0.2.85",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "pdf-lib": "1.17.1",
    "vite": "8.3.1"
  }
}
